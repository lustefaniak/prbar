#!/usr/bin/env bash
# Compile the review prompts and the AI output schema into the binary.
#
# Writes Sources/PRBarCore/Services/Review/EmbeddedResources.swift from
# Sources/PRBarCore/Resources/{prompts,schemas}. The .md / .json files stay
# the ones you edit; this file is generated from them and checked in, so a
# SwiftPM or Linux build needs nothing but the sources. `bin/regen` runs it,
# and EmbeddedResourcesTests fails when it is out of date.
set -euo pipefail
cd "$(dirname "$0")/.."

src=Sources/PRBarCore/Resources
out=Sources/PRBarCore/Services/Review/EmbeddedResources.swift
tmp="$out.tmp"

{
  echo "// Generated by bin/gen-resources from Sources/PRBarCore/Resources. Do not edit."
  echo
  echo "enum EmbeddedResources {"
  echo "    static let files: [String: String] = ["
  for file in "$src"/prompts/*.md "$src"/schemas/*.json; do
    rel="${file#"$src"/}"
    # Enough #s that the file can't end the raw string or interpolate.
    hashes="#"
    while grep -qF "\"\"\"$hashes" "$file" || grep -qF "\\$hashes" "$file"; do
      hashes="$hashes#"
    done
    echo "        \"$rel\": $hashes\"\"\""
    cat "$file"
    # A multi-line literal drops the newline before its closing quotes.
    echo
    echo "\"\"\"$hashes,"
  done
  echo "    ]"
  echo "}"
} > "$tmp"
mv "$tmp" "$out"
